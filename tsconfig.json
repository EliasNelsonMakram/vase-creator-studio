{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,

    "paths": {
      "@/*": ["./src/*"]
    },

    "types": ["node"],

    "allowImportingTsExtensions": false,
    "noEmit": true
  },

  "include": [
    "src",
    "test",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}